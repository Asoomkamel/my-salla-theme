{#
    Header Component
    Contains navigation, logo, and cart icon
#}

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-sm">
    {# Top Bar #}
    <div class="bg-dark text-white text-sm py-2">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <span>{{ trans('site.welcome_message') }}</span>
            <div class="flex items-center space-x-4">
                <a href="#" class="hover:text-gray-300 transition">{{ trans('site.help') }}</a>
                <span>|</span>
                <a href="{{ link('account') }}" class="hover:text-gray-300 transition">{{ trans('site.my_account') }}</a>
            </div>
        </div>
    </div>

    {# Main Header #}
    <div class="border-b border-gray-100">
        <div class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                {# Logo #}
                <a href="{{ link('home') }}" class="flex items-center space-x-3">
                    <div class="w-12 h-12 gradient-bg rounded-xl flex items-center justify-center">
                        <span class="text-white font-bold text-xl">S</span>
                    </div>
                    <span class="text-xl font-bold text-dark hidden sm:block">{{ store.name }}</span>
                </a>

                {# Search Bar #}
                <div class="hidden md:flex flex-1 max-w-xl mx-8">
                    <div class="relative w-full">
                        <input type="search" placeholder="{{ trans('site.search_placeholder') }}" class="w-full px-5 py-3 pr-12 rounded-xl border border-gray-200 focus:border-custom-primary focus:ring-2 focus:ring-custom-primary/20 outline-none transition">
                        <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-custom-primary transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                {# Actions #}
                <div class="flex items-center space-x-4">
                    {# Language Selector #}
                    <div class="hidden sm:block">
                        <a href="?lang={{ locale == 'ar' ? 'en' : 'ar' }}" class="flex items-center space-x-1 text-gray-700 hover:text-custom-primary transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                            </svg>
                            <span class="text-sm font-medium uppercase">{{ locale }}</span>
                        </a>
                    </div>

                    {# Wishlist #}
                    <a href="{{ link('wishlist') }}" class="relative p-2 text-gray-700 hover:text-custom-primary transition">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                        {% if customer.wishlist_count > 0 %}
                            <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center">{{ customer.wishlist_count }}</span>
                        {% endif %}
                    </a>

                    {# Cart #}
                    <a href="{{ link('cart') }}" class="relative p-2 text-gray-700 hover:text-custom-primary transition">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                        </svg>
                        {% if cart.count > 0 %}
                            <span class="absolute -top-1 -right-1 w-5 h-5 bg-custom-primary text-white text-xs rounded-full flex items-center justify-center">{{ cart.count }}</span>
                        {% endif %}
                    </a>

                    {# Mobile Menu Toggle #}
                    <button class="md:hidden p-2 text-gray-700" onclick="document.getElementById('mobileMenu').classList.toggle('hidden')">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Navigation #}
    <nav class="hidden md:block bg-white border-b border-gray-100">
        <div class="container mx-auto px-4">
            <div class="flex items-center space-x-8 py-3">
                {% for item in menu.main %}
                    <a href="{{ item.url }}" class="nav-link relative text-gray-700 hover:text-custom-primary font-medium transition py-2">
                        {{ item.title }}
                    </a>
                {% endfor %}
            </div>
        </div>
    </nav>

    {# Mobile Menu #}
    <div id="mobileMenu" class="hidden md:hidden bg-white border-t">
        <div class="container mx-auto px-4 py-4 space-y-2">
            {# Mobile Search #}
            <div class="mb-4">
                <input type="search" placeholder="{{ trans('site.search_placeholder') }}" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-custom-primary outline-none">
            </div>

            {% for item in menu.main %}
                <a href="{{ item.url }}" class="block px-4 py-3 rounded-lg hover:bg-gray-50 text-gray-700 hover:text-custom-primary transition">
                    {{ item.title }}
                </a>
            {% endfor %}
        </div>
    </div>
</header>
