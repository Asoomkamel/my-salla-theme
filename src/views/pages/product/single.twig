{#
    Product Page Template
    Single product detail page
#}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4">
        {# Breadcrumb #}
        <nav class="mb-8">
            <ol class="flex items-center space-x-2 text-sm">
                <li><a href="{{ link('home') }}" class="text-gray-500 hover:text-custom-primary transition">{{ trans('site.home') }}</a></li>
                <li class="text-gray-400">/</li>
                <li><a href="{{ link('products') }}" class="text-gray-500 hover:text-custom-primary transition">{{ trans('site.products') }}</a></li>
                <li class="text-gray-400">/</li>
                <li class="text-custom-primary font-medium">{{ product.name }}</li>
            </ol>
        </nav>

        <div class="grid lg:grid-cols-2 gap-12">
            {# Product Images #}
            <div class="space-y-4">
                <div class="bg-white rounded-2xl shadow-card overflow-hidden">
                    <div class="aspect-square bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center p-8">
                        <div class="w-full h-full bg-gray-300 rounded-xl flex items-center justify-center">
                            <svg class="w-24 h-24 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                        </div>
                    </div>
                </div>
                {# Thumbnail Gallery #}
                <div class="grid grid-cols-4 gap-4">
                    {% for i in 1..4 %}
                        <div class="bg-white rounded-lg p-2 cursor-pointer border-2 border-transparent hover:border-custom-primary transition">
                            <div class="aspect-square bg-gray-100 rounded"></div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Product Info #}
            <div>
                <div class="bg-white rounded-2xl shadow-card p-8">
                    {# Product Title & SKU #}
                    <h1 class="text-3xl font-bold text-dark mb-2">{{ product.name }}</h1>
                    <p class="text-gray-500 mb-4">SKU: {{ product.sku }}</p>

                    {# Rating #}
                    <div class="flex items-center space-x-2 mb-6">
                        <div class="flex text-yellow-400">
                            {% for i in 1..5 %}
                                <svg class="w-5 h-5 {% if i <= 4 %}fill-current{% else %}text-gray-300{% endif %}" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                            {% endfor %}
                        </div>
                        <span class="text-gray-500">({{ product.rating_count|default(24) }} {{ trans('site.reviews') }})</span>
                    </div>

                    {# Price #}
                    <div class="mb-6">
                        <div class="flex items-baseline space-x-3">
                            <span class="text-4xl font-bold text-custom-primary">{{ product.price|price }}</span>
                            {% if product.compare_at_price > product.price %}
                                <span class="text-xl text-gray-400 line-through">{{ product.compare_at_price|price }}</span>
                                <span class="bg-red-100 text-red-600 px-2 py-1 rounded-lg text-sm font-semibold">
                                    -{{ ((1 - product.price / product.compare_at_price) * 100)|round }}%
                                </span>
                            {% endif %}
                        </div>
                        <p class="text-gray-500 text-sm mt-1">{{ trans('site.tax_included') }}</p>
                    </div>

                    {# Short Description #}
                    <div class="mb-6">
                        <p class="text-gray-600">{{ product.short_description|default('High-quality product with premium features. Perfect for everyday use.') }}</p>
                    </div>

                    {# Options (Size, Color, etc.) #}
                    <div class="space-y-4 mb-6">
                        {# Color Selection #}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.color') }}</label>
                            <div class="flex space-x-3">
                                {% for color in ['bg-black', 'bg-white border', 'bg-blue-500', 'bg-red-500'] %}
                                    <button class="w-10 h-10 rounded-lg {{ color }} ring-2 ring-offset-2 ring-custom-primary"></button>
                                {% endfor %}
                            </div>
                        </div>

                        {# Size Selection #}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.size') }}</label>
                            <div class="flex space-x-3">
                                {% for size in ['S', 'M', 'L', 'XL'] %}
                                    <button class="px-4 py-2 border-2 border-gray-200 rounded-lg hover:border-custom-primary transition">{{ size }}</button>
                                {% endfor %}
                            </div>
                        </div>

                        {# Quantity #}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.quantity') }}</label>
                            <div class="flex items-center space-x-4">
                                <div class="flex items-center border-2 border-gray-200 rounded-lg">
                                    <button class="px-4 py-2 text-gray-600 hover:text-custom-primary transition">-</button>
                                    <span class="px-4 py-2 font-medium">1</span>
                                    <button class="px-4 py-2 text-gray-600 hover:text-custom-primary transition">+</button>
                                </div>
                                <span class="text-gray-500 text-sm">{{ trans('site.in_stock') }}</span>
                            </div>
                        </div>
                    </div>

                    {# Add to Cart & Wishlist #}
                    <div class="flex space-x-4 mb-6">
                        <button class="flex-1 gradient-bg text-white px-8 py-4 rounded-xl font-semibold hover:opacity-90 transition shadow-lg shadow-purple-500/30 flex items-center justify-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                            </svg>
                            <span>{{ trans('site.add_to_cart') }}</span>
                        </button>
                        <button class="px-4 py-4 border-2 border-gray-200 rounded-xl hover:border-red-500 hover:text-red-500 transition">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                        </button>
                    </div>

                    {# Features #}
                    <div class="border-t pt-6 space-y-3">
                        <div class="flex items-center space-x-3 text-sm text-gray-600">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>{{ trans('site.free_shipping') }}</span>
                        </div>
                        <div class="flex items-center space-x-3 text-sm text-gray-600">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>{{ trans('site.secure_checkout') }}</span>
                        </div>
                        <div class="flex items-center space-x-3 text-sm text-gray-600">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>{{ trans('site.returns_within') }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Product Tabs #}
        <div class="mt-12 bg-white rounded-2xl shadow-card">
            <div class="border-b">
                <div class="flex space-x-8 px-8">
                    <button class="py-4 border-b-2 border-custom-primary text-custom-primary font-semibold">{{ trans('site.description') }}</button>
                    <button class="py-4 border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition">{{ trans('site.additional_info') }}</button>
                    <button class="py-4 border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition">{{ trans('site.reviews') }} ({{ product.rating_count|default(24) }})</button>
                </div>
            </div>
            <div class="p-8">
                <div class="prose max-w-none">
                    <p>{{ product.description|default('This is a premium quality product that combines style and functionality. Made with the finest materials, it offers exceptional durability and comfort. Perfect for everyday use and suitable for various occasions.') }}</p>
                </div>
            </div>
        </div>

        {# Related Products #}
        <div class="mt-12">
            <h2 class="text-2xl font-bold text-dark mb-8">{{ trans('site.related_products') }}</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {% for i in 1..4 %}
                    <div class="bg-white rounded-2xl shadow-card overflow-hidden">
                        <div class="aspect-square bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                            <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                            </svg>
                        </div>
                        <div class="p-4">
                            <h3 class="font-semibold text-dark mb-1 line-clamp-2">Related Product {{ i }}</h3>
                            <span class="text-lg font-bold text-custom-primary">$79.00</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
