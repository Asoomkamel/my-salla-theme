{#
    Customer Account Profile Page
    User account and order history
#}

<div class="min-h-screen bg-gray-50 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-dark mb-8">{{ trans('site.my_account') }}</h1>

        <div class="grid lg:grid-cols-4 gap-8">
            {# Sidebar #}
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-card p-6">
                    {# User Info #}
                    <div class="text-center mb-6 pb-6 border-b">
                        <div class="w-20 h-20 bg-gradient-to-br from-custom-primary to-custom-secondary rounded-full flex items-center justify-center mx-auto mb-4">
                            <span class="text-white text-2xl font-bold">{{ customer.name|first|upper }}</span>
                        </div>
                        <h3 class="font-semibold text-dark">{{ customer.name }}</h3>
                        <p class="text-gray-500 text-sm">{{ customer.email }}</p>
                    </div>

                    {# Navigation #}
                    <nav class="space-y-2">
                        <a href="{{ link('account') }}" class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-custom-primary/10 text-custom-primary font-medium">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span>{{ trans('site.profile') }}</span>
                        </a>
                        <a href="{{ link('orders') }}" class="flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-50 text-gray-700 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                            </svg>
                            <span>{{ trans('site.my_orders') }}</span>
                        </a>
                        <a href="{{ link('wishlist') }}" class="flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-50 text-gray-700 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                            </svg>
                            <span>{{ trans('site.wishlist') }}</span>
                        </a>
                        <a href="#" class="flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-50 text-gray-700 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>{{ trans('site.addresses') }}</span>
                        </a>
                        <hr class="my-4">
                        <a href="#" class="flex items-center space-x-3 px-4 py-3 rounded-xl hover:bg-gray-50 text-red-500 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg>
                            <span>{{ trans('site.logout') }}</span>
                        </a>
                    </nav>
                </div>
            </div>

            {# Main Content #}
            <div class="lg:col-span-3 space-y-6">
                {# Profile Info #}
                <div class="bg-white rounded-2xl shadow-card p-6">
                    <h2 class="text-xl font-bold text-dark mb-6">{{ trans('site.personal_information') }}</h2>
                    <form class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.first_name') }}</label>
                            <input type="text" value="{{ customer.first_name }}" class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-custom-primary outline-none transition">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.last_name') }}</label>
                            <input type="text" value="{{ customer.last_name }}" class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-custom-primary outline-none transition">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.email') }}</label>
                            <input type="email" value="{{ customer.email }}" class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-custom-primary outline-none transition">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">{{ trans('site.phone') }}</label>
                            <input type="tel" value="{{ customer.phone }}" class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-custom-primary outline-none transition">
                        </div>
                        <div class="md:col-span-2">
                            <button type="submit" class="gradient-bg text-white px-8 py-3 rounded-xl font-semibold hover:opacity-90 transition">
                                {{ trans('site.save_changes') }}
                            </button>
                        </div>
                    </form>
                </div>

                {# Recent Orders #}
                <div class="bg-white rounded-2xl shadow-card p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl font-bold text-dark">{{ trans('site.recent_orders') }}</h2>
                        <a href="{{ link('orders') }}" class="text-custom-primary font-medium hover:underline">{{ trans('site.view_all') }}</a>
                    </div>
                    <div class="space-y-4">
                        {% for order in orders|slice(0, 3) %}
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl">
                                <div>
                                    <p class="font-medium text-dark">Order #{{ order.id }}</p>
                                    <p class="text-gray-500 text-sm">{{ order.date }}</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-bold text-custom-primary">{{ order.total|price }}</p>
                                    <span class="inline-block px-2 py-1 text-xs rounded-full
                                        {% if order.status == 'completed' %}bg-green-100 text-green-700
                                        {% elseif order.status == 'pending' %}bg-yellow-100 text-yellow-700
                                        {% else %}bg-gray-100 text-gray-700{% endif %}">
                                        {{ order.status_text }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
